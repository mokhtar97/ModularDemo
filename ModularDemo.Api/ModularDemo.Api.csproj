<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ModularDemo.Modules.Content\ModularDemo.Modules.Content.csproj" />
    <ProjectReference Include="..\ModularDemo.Modules.Orders\ModularDemo.Modules.Orders.csproj" />
    <ProjectReference Include="..\ModularDemo.Modules.Shipping\ModularDemo.Modules.Shipping.csproj" />
    <ProjectReference Include="..\ModularDemo.Shared\ModularDemo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Full Umbraco CMS (backoffice, website, Delivery API, SQL Server + SQLite providers) -->
    <PackageReference Include="Umbraco.Cms" Version="17.7.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Settings taken from the official Umbraco 17 project template -->
  <PropertyGroup>
    <!-- Backoffice files are pre-compressed by Umbraco; don't let dotnet compress them again. -->
    <CompressionEnabled>false</CompressionEnabled>
    <!-- Keep Razor files in the publish output (needed by the backoffice). -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <!-- ModelsBuilder "InMemoryAuto" compiles views at runtime. -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

</Project>
