@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.Value("pageTitle")</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        header {
            background: #222;
            padding: 20px;
        }

        header a {
            color: white;
            margin-right: 20px;
            text-decoration: none;
        }

        main {
            padding: 50px;
        }

        .contact {
            background: #f5f5f5;
            padding: 20px;
            max-width: 500px;
        }
    </style>
</head>

<body>

<header>
    <a href="/">Home</a>
    <a href="/about/">About</a>
    <a href="/contact/">Contact</a>
</header>

<main>

    <h1>@Model.Value("pageTitle")</h1>

    <div class="contact">

        <p>
            <strong>Email:</strong>
            @Model.Value("email")
        </p>

        <p>
            <strong>Phone:</strong>
            @Model.Value("phone")
        </p>

        <p>
            @Model.Value("message")
        </p>

    </div>

</main>

</body>
</html>