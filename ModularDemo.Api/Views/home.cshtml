@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@Model.Value("pageTitle")</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
        }

        header {
            background: #222;
            padding: 20px;
        }

        header a {
            color: white;
            margin-right: 20px;
            text-decoration: none;
        }

        main {
            padding: 50px;
        }
    </style>
</head>

<body>

<header>
    <a href="/">Home</a>
    <a href="/about/">About</a>
    <a href="/contact/">Contact</a>
</header>

<main>

    <h1>@Model.Value("pageTitle")</h1>

    <p>
        @Model.Value("heroText")
    </p>

</main>

</body>
</html>